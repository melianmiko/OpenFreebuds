#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"

# Bundled OpenSSL only knows the Debian-style certificate path
if [ -z "$SSL_CERT_FILE" ]; then
    for bundle in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
                  /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        if [ -f "$bundle" ]; then
            export SSL_CERT_FILE="$bundle"
            break
        fi
    done
fi

OFB_APPIMAGE_REPO="$(cat "$HERE/update-repo" 2>/dev/null)"
export OFB_APPIMAGE_REPO

# -I: ignore PYTHON* variables, user site and the current directory
exec "$HERE/usr/bin/python3" -I -B -m openfreebuds_qt "$@"
